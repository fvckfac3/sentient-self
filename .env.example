# Copy to .env and fill in. Variables marked (required) must be set in every
# environment; the rest switch on optional features.

# ─── Database (required) ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/sentient_self"

# ─── Auth (required) ─────────────────────────────────────────────────
# Your site's public URL, e.g. https://sentientself.com in production
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# OAuth sign-in (optional). Each provider and its button appear only when set.
# Google redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple: Services ID and the generated client secret JWT
APPLE_ID=""
APPLE_SECRET=""

# ─── AI providers ────────────────────────────────────────────────────
# DeepSeek (required): free-tier chat, exercise insights and journal analysis
DEEPSEEK_API_KEY=""
# Premium models - set the providers you want to offer
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# ─── Stripe (required for billing) ───────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
# From the webhook endpoint pointing at /api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PREMIUM_PRICE_ID="price_..."
STRIPE_INSTITUTION_PRICE_ID="price_..."

# ─── Rate limiting (recommended in production) ───────────────────────
# Upstash Redis REST credentials (Vercel's KV_REST_API_URL / KV_REST_API_TOKEN also work).
# Without them, limits are kept in memory per server instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Error monitoring (optional) ─────────────────────────────────────
# Sentry stays off until the DSN is set
NEXT_PUBLIC_SENTRY_DSN=""
# Fraction of requests to trace for performance (0 = errors only)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"
# For readable stack traces: source map upload during build
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─── Site ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@sentientself.com"
